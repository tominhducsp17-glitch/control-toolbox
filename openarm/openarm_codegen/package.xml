<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_codegen</name>
  <version>0.1.0</version>
  <description>Offline generator: Pinocchio (CppADCodeGen scalar) + control-toolbox code generation write the OpenArm model (M, C, G per arm) as plain C++.</description>
  <maintainer email="tominhducsp17@gmail.com">To Minh Duc</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ct_core</depend>
  <depend>pinocchio</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
