{
  "names": {
    "ct_core": {
      "cmake-args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_EXAMPLES=ON",
        "-DCMAKE_DISABLE_FIND_PACKAGE_Python=ON",
        "-DCMAKE_DISABLE_FIND_PACKAGE_PythonLibs=ON"
      ]
    },
    "ct_optcon": {
      "cmake-args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_EXAMPLES=ON"
      ]
    },
    "ct_models": {
      "cmake-args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTS=ON"
      ]
    },
    "ct_nlc": {
      "cmake-args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTS=ON",
        "-DBUILD_EXAMPLES=ON"
      ]
    }
  }
}
